{
  "name": "@klinth/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skill:local": "wrangler kv key put design-skill --binding SKILL --path skill/skill.md --local",
    "check:bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@klinth/core": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "wrangler": "^4.157.0"
  }
}
