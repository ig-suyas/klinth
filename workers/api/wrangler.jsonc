{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "klinth-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
    // Invocation logs record request headers, which would include X-Gemini-Key.
    // Only our own outcome lines (no keys, bodies or skill) are logged.
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "vars": {
    // Production editor origin. Local dev overrides it in .dev.vars (localhost:5173).
    "ALLOWED_ORIGINS": "https://klinth.pages.dev",
    // Stable free-tier model, verified 2026-11-04. Change here if Google retires it.
    "GEMINI_MODEL": "gemini-3.6-flash",
    // minimal | low | medium | high. Lowest thinking keeps the user's quota and waits small.
    "GEMINI_THINKING_LEVEL": "minimal",
    // GitHub OAuth app id (public, callback https://klinth.pages.dev/github-callback.html). Secret:
    //   npx wrangler secret put GITHUB_CLIENT_SECRET      (production)
    //   workers/api/.dev.vars                             (local, git-ignored)
    "GITHUB_CLIENT_ID": "Ov23liHbdVjZ2EXOgKJ0",
  },
  // The private design skill, key "design-skill". Put it with:
  //   npm run skill:local -w @klinth/api            (local dev)
  //   npx wrangler kv key put design-skill --binding SKILL --path skill/skill.md --remote
  // Created in Phase 8 (wrangler kv namespace create SKILL).
  "kv_namespaces": [{ "binding": "SKILL", "id": "a35fe0087d1d4de39f4550479ef5fa33" }],
  // Exact hourly limit per IP (SQLite-backed, the only kind on the free plan).
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Short-window burst guard (approximate, per Cloudflare location).
  "ratelimits": [
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
}
