# Names only. Never commit real values.

# --- Editor (apps/editor/.env.local) ---
# Base URL of the Klinth API Worker. Local default shown.
VITE_API_BASE_URL=http://localhost:8787

# --- Worker (workers/api/.dev.vars locally, `wrangler secret put` in production) ---
# Origins allowed by CORS, comma separated.
ALLOWED_ORIGINS=http://localhost:5173
# Gemini model id and thinking level (set in workers/api/wrangler.jsonc "vars").
# Verified 2026-11-04: gemini-3.6-flash is stable and free. Thinking: minimal | low | medium | high.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
# The private design skill is not an env var: it lives in Workers KV under the key "design-skill".
# GitHub OAuth app (Phase 6). The secret is set with `wrangler secret put`, never in a file in git.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
